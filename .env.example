# Variáveis de ambiente do Dashboard de Clima
# Copie para .env e preencha com seus valores reais.
# A chave em si é injetada via src/environments/environment.ts no Angular;
# este arquivo serve como referência para CI/CD ou scripts auxiliares.

OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_LANG=pt_br
OPENWEATHER_UNITS=metric
